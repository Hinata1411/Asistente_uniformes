rules_version = '2';
// Reglas de Firebase Storage: solo usuarios autenticados, imágenes de hasta 5 MB.
service firebase.storage {
  match /b/{bucket}/o {
    function isStaff() {
      return request.auth != null
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['admin', 'empleado']
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('active', true) == true;
    }

    match /{allPaths=**} {
      allow read: if isStaff();
      allow create, update: if isStaff()
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp'];
      allow delete: if isStaff();
    }
  }
}
